# Copy this file to .env and fill in the values. NEVER put real values in this file
# (it is tracked by git and public). NEVER commit .env.
ENV_MODE=development
PROJECT_NAME=Wajahni

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local PostgreSQL + pgvector. Use letters and digits only in the password so the URL needs no encoding.
POSTGRES_USER=wajahni
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wajahni
# Must use the same password as POSTGRES_PASSWORD
DATABASE_ASYNC_URL=postgresql+asyncpg://wajahni:PASSWORD_HERE@localhost:5432/wajahni

# Optional. Leave empty unless free-tier use of the exact model is verified (see docs/COST_POLICY.md).
# Never link a Google Cloud billing account to the project that owns this key.
GEMINI_API_KEY=
